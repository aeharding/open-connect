# Raw bench evidence: immutable originals remain local.
/logs/
/captures/
/inventory/
/runs/
/examples/tooling-runs/
/exports/backups/
/backups/
/.state/
/.bench-state/
/locks/
/sessions/
# Original reference snapshots, private context and copied device data.
/research/sources/snapshots/
/research/context/private/
/research/context/originals/
# Host environments, transient state and caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.cache-*/
.DS_Store
# Credentials and private key material. Stage by explicit allowlist regardless.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
credentials*
secrets*
private/
*.sqlite*
*.db


# Generated experimental checks/builds remain local.
/experiments/**/checks/
/experiments/installer-proof/before-resume/
/experiments/webcam-control/build-evidence/
/experiments/webcam-control/vendor/
/experiments/webcam-control/uvc-util

/experiments/**/adapter-checks/
/experiments/installer-proof/before-disclaimer-adapter/
/experiments/installer-proof/before-complete-recovery/
/experiments/target-copy-transaction/prepared/

# First startup trial: generated payloads and private check transcripts
/experiments/disclaimer-startup-trial/prepared/
/experiments/disclaimer-startup-trial/review-ready/
/experiments/disclaimer-startup-trial/review-ready-final/
/experiments/disclaimer-startup-trial/root-checks/
/experiments/disclaimer-startup-trial/entry-checks/

# Local comparison adaptations retain incompatible upstream noncommercial terms.
# Keep them for bench research; do not publish under the project's AGPL license.
/experiments/comparison-disclaimer55/
/experiments/disclaimer-snap55/
/experiments/**/recovery-checks/

# Local progress page and retired input captures are not public source.
/.local/
/research/
/examples/
/dashboard/
*.egg-info/
/build/
/dist/

# Retired demo working files remain private if present on the original bench.
/experiments/ui001/
/experiments/status-overlay/
