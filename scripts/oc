#!/usr/bin/env python3
"""Open Connect CLI: small semantic operations backed by the existing bench tools."""
import importlib.util
from pathlib import Path
import sys

ROOT=Path(__file__).resolve().parents[1]

def main(argv=None):
    argv=list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h","--help"):
        print("usage: oc bench {setup,status,teardown} [options]\n\nOne development profile. Dry-run by default; use --live for the bench.\nRun oc bench --help for connection/evidence options.")
        return 0
    if argv.pop(0)!="bench":
        print("Unknown operation. Available: oc bench",file=sys.stderr)
        return 2
    spec=importlib.util.spec_from_file_location("oc_bench_profile",ROOT/"bench/profile.py")
    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
    return module.main(argv)

if __name__=="__main__":raise SystemExit(main())
